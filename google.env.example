# Copy these settings into .env OR google.env in this same folder. Replace both values with your real Google OAuth credentials.
GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PASTE_YOUR_GOOGLE_CLIENT_SECRET_HERE
# Must match the authorised redirect URI in Google Cloud Console exactly.
GOOGLE_REDIRECT_URI=http://127.0.0.1:3030/auth/google/callback
OLLAMA_MODEL=qwen2.5:3b
